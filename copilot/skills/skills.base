formulas:
  Senza titolo: ""
views:
  - type: table
    name: Tabella
    filters:
      and:
        - file.inFolder("PoliMi/copilot/skills")
    order:
      - file.basename
      - file.ctime
      - file.embeds
      - description
    sort:
      - property: file.backlinks
        direction: ASC
